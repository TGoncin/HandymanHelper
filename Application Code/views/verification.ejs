<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HandymanHelper - Verify Identity</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/ENSE-281_Lab7_stylesheet.css">
</head>

<body class="pb-5">
  <div class="mobile-container">

    <!-- _____ HEADER _____ -->
    <header class="bg-white p-3 sticky-top">
      <div class="container">
        <div class="text-center w-100">
          <a href="/marketplace" class="css-logo">
            <span class="logo-top">HANDYMAN</span>
            <span class="logo-bottom">HELPER</span>
          </a>
        </div>
      </div>
    </header>


    <!-- _____ MAIN CONTENT _____ -->
    <main class="container mt-4">

      <!-- Error Alert -->
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-circle-fill me-2"></i><strong><%= error %></strong>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <!-- Title Card -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white border-0 py-3">
          <h5 class="fw-bold mb-0">
            <i class="bi bi-shield-check me-2"></i>Choose one of two options to get verified:
          </h5>
        </div>
        <div class="card-body text-center py-2">
          <small class="text-muted">Submit your credentials to unlock bidding on jobs.</small>
        </div>
      </div>

      <!-- MANDATORY: First Name -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
          <label class="form-label fw-bold text-primary"><i class="bi bi-person-fill me-1"></i> First Name <span class="text-danger">*</span></label>
          <input type="text" id="globalFirstName" class="form-control form-control-lg" placeholder="Enter your first name" required>
          <small class="text-muted">This is required for verification.</small>
        </div>
      </div>

      <!-- OPTION 1: Upload License Photo -->
      <div class="card shadow-sm border-primary mb-3">
        <div class="card-body text-center p-4">
          <h6 class="fw-bold text-primary mb-3"><i class="bi bi-camera-fill me-1"></i> Option 1: Upload License Photo</h6>
          <form id="photoVerifyForm" action="/verify" method="post" enctype="multipart/form-data">
            <input type="hidden" name="username" value="<%= currentUser.username %>">
            <input type="hidden" name="firstName" id="photoFirstName" value="">
            <input type="hidden" name="licenseNumber" value="PHOTO-UPLOAD">
            <input type="hidden" name="verificationCode" value="">
            <div class="border rounded p-4 bg-light mb-3">
              <i class="bi bi-cloud-arrow-up display-4 text-primary"></i>
              <input type="file" name="licenseImage" class="form-control mt-3" accept="image/*" capture="camera" required>
              <small class="text-muted d-block mt-2">Take a photo or upload your trade/craft/skill certificate or license</small>
            </div>
            <button type="button" class="btn btn-primary w-100 fw-bold py-2" onclick="submitWithAnimation('photoVerifyForm')">
              Submit
            </button>
          </form>
        </div>
      </div>

      <!-- OR Divider -->
      <div class="text-center my-4">
        <div class="d-flex align-items-center">
          <hr class="flex-grow-1">
          <span class="fw-bold fs-5 text-muted mx-3">OR</span>
          <hr class="flex-grow-1">
        </div>
      </div>

      <!-- OPTION 2: Enter Invite Code -->
      <div class="card shadow-sm border-primary mb-4">
        <div class="card-body text-center p-4">
          <h6 class="fw-bold text-primary mb-3"><i class="bi bi-key-fill me-1"></i> Option 2: Invite Code</h6>
          <p class="text-muted small mb-3">If you've received the invite code, please enter it below:</p>
          <form id="codeVerifyForm" action="/verify" method="post" enctype="multipart/form-data">
            <input type="hidden" name="username" value="<%= currentUser.username %>">
            <input type="hidden" name="firstName" id="codeFirstName" value="">
            <input type="hidden" name="licenseNumber" value="CODE-VERIFY">
            <input type="text" name="verificationCode" class="form-control form-control-lg text-center mb-3"
              placeholder="Enter invite code" required>
            <button type="button" class="btn btn-primary w-100 fw-bold py-2" onclick="submitWithAnimation('codeVerifyForm')">
              Submit
            </button>
          </form>
        </div>
      </div>

      <!-- Back Link -->
      <div class="text-center">
        <a href="/dashboard?username=<%= currentUser.username %>" class="btn btn-outline-secondary w-100 py-2">
          <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
      </div>

    </main>
  </div>


  <!-- Validating Overlay -->
  <div class="modal fade" id="validatingModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content border-0 shadow text-center p-4">
        <div class="spinner-border text-primary mx-auto mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
        <h5 class="fw-bold" id="validatingTitle">Validating Account.</h5>
        <p class="text-muted mb-0" id="validatingDots">Rendering..</p>
      </div>
    </div>
  </div>


  <script>
    // _____ DARK MODE _____
    var body = document.body;
    var mainLogo = document.getElementById('mainLogo');

    function updateLogo(isDark) {
      if (mainLogo) {
        mainLogo.src = isDark ? '/images/logo-dark.png' : '/images/logo.png';
      }
    }

    var savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') {
      body.classList.add('dark-mode');
      updateLogo(true);
    } else {
      updateLogo(false);
    }


    // _____ VERIFICATION ANIMATION _____
    function submitWithAnimation(formId) {
      var firstNameInput = document.getElementById('globalFirstName');
      var firstName = firstNameInput.value.trim();

      // Validate first name before submitting
      if (!firstName) {
        firstNameInput.classList.add('is-invalid');
        firstNameInput.focus();
        firstNameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      firstNameInput.classList.remove('is-invalid');

      // Copy first name into the form's hidden field
      document.getElementById('photoFirstName').value = firstName;
      document.getElementById('codeFirstName').value = firstName;

      var form = document.getElementById(formId);
      var validatingModal = new bootstrap.Modal(document.getElementById('validatingModal'));
      var title = document.getElementById('validatingTitle');
      var dots = document.getElementById('validatingDots');

      validatingModal.show();

      // Iteration 1
      title.textContent = 'Validating Account.';
      dots.textContent = 'Rendering..';

      setTimeout(function() {
        // Iteration 2
        title.textContent = 'Validating Account.';
        dots.textContent = 'Rendering...';

        setTimeout(function() {
          // Iteration 3
          title.textContent = 'Validating Account.';
          dots.textContent = 'Rendering..';

          setTimeout(function() {
            form.submit();
          }, 400);
        }, 400);
      }, 500);
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>